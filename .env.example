# 複製為 .env 後填寫；mcp-server.ts 啟動時會自動載入（已設定的環境變數優先）

# ComfyUI 與輸出目錄
COMFYUI_URL=http://127.0.0.1:8188
OUTPUT_DIR=./data/outputs
UPLOAD_DIR=./data/uploads

# 中文提示詞轉譯：先試 vLLM，失敗改用 Ollama，都失敗則沿用原文
VLLM_URL=http://127.0.0.1:8787
VLLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 伺服器綁定。預設只聽本機；改成 0.0.0.0 或區網 IP 讓其他電腦連線時必須設定 MCP_AUTH_TOKEN
HOST=127.0.0.1
PORT=8833
# /mcp、/sse、/messages 需帶 Authorization: Bearer <token>。請產生長隨機值，勿提交 Git
MCP_AUTH_TOKEN=
# 其他電腦開啟 Web UI 時要輸入的密碼（瀏覽器會跳出登入框，帳號任意）。
# 留空表示 Web UI 與其 API 只限本機；本機開啟一律不需密碼
WEBUI_PASSWORD=
# 允許跨來源呼叫的網址（逗號分隔）；留空表示只允許同源 Web UI
CORS_ORIGINS=

# 頭像生成
PORTRAIT_TIMEOUT_SECONDS=600
PORTRAIT_TRANSLATE_TIMEOUT_SECONDS=60
# 頭像提示詞翻譯用的 Ollama 模型（與 Web UI 派工用的 OLLAMA_MODEL 分開）
PORTRAIT_OLLAMA_MODEL=qwen3.5:4b
# 使用的敏感詞分類（data/Sensitive-lexicon/Vocabulary/<名稱>.txt），另會加上 data/portrait_blocklist.txt
PORTRAIT_LEXICON_CATEGORIES=色情类型,色情词库,暴恐词库,涉枪涉爆,反动词库,政治类型
